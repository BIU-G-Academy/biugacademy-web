PORT=3000
DATABASE_URL=
FRONTEND_ORIGIN=https://biugacademy.org
NODE_ENV=development

# Transactional email (Resend HTTP API; no SMTP credentials in client code)
RESEND_API_KEY=
SUPPORT_EMAIL=support@biugacademy.org
EMAIL_FROM=BIU.G Academy <support@biugacademy.org>
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5

# Legacy FastAPI service (fastapi_intake.py) only.
# /ai/* routes require header X-Service-Token equal to this value (min 32 chars).
# Leave empty to keep those routes disabled (they return 503).
AI_SERVICE_TOKEN=
