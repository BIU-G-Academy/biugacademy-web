PORT=3000
DATABASE_URL=
FRONTEND_ORIGIN=https://biugacademy.org
NODE_ENV=development

# Transactional email (Resend HTTP API; no SMTP credentials in client code)
RESEND_API_KEY=
SUPPORT_EMAIL=support@biugacademy.org
EMAIL_FROM=BIU.G Academy <support@biugacademy.org>
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5

# Learning MVP. Personal-data intake has no reopen switch in this build.
# Synthetic demo is refused when NODE_ENV=production. Do not put a real password here.
ACADEMY_SYNTHETIC_DEMO=
ACADEMY_ACCOUNT_PROVISIONING=
ACADEMY_SYNTHETIC_PASSWORD=
# Ignored. No verified CubeShackles tool contract is pinned. Do not put a secret or base URL to call.
CUBESHACKLES_TOOL_BASE_URL=
